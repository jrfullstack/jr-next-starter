# =============================================================================
#  Variables de entorno
# =============================================================================
#  1. Copia este archivo como `.env` y rellena los valores.
#  2. Todas se validan al arrancar en `src/env.ts` (T3-env): si falta una
#     obligatoria o tiene un formato incorrecto, `pnpm dev` / `pnpm build` se
#     detienen indicando cuál.
#  3. Para añadir una variable nueva: declárala aquí (con su descripción) y en
#     `src/env.ts`.
#
#  ⚠️ Las variables `NEXT_PUBLIC_*` se incluyen en el JavaScript del navegador:
#     cualquiera puede verlas. Nunca pongas secretos en ellas.
# =============================================================================


# -----------------------------------------------------------------------------
#  DATABASE_URL · servidor · OBLIGATORIA
# -----------------------------------------------------------------------------
#  Cadena de conexión a PostgreSQL.
#  Se usa en: src/lib/db.ts (cliente de Prisma) y prisma.config.ts (CLI de
#  Prisma: migraciones, studio…).
#  Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
#  Local:   una base en Docker o `pnpm exec prisma dev` (Postgres local de Prisma).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"


# -----------------------------------------------------------------------------
#  BETTER_AUTH_SECRET · servidor · OBLIGATORIA
# -----------------------------------------------------------------------------
#  Clave con la que Better Auth firma y cifra sesiones y tokens.
#  Se usa en: src/lib/auth/server.ts.
#  Formato: mínimo 32 caracteres aleatorios. Si cambia, se cierran todas las
#  sesiones abiertas. Usa una distinta en cada entorno (local, producción).
#  Generar:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""


# -----------------------------------------------------------------------------
#  SUPER_ADMIN_EMAILS · servidor · OBLIGATORIA
# -----------------------------------------------------------------------------
#  Emails de los desarrolladores, separados por comas.
#  Una cuenta es `superadmin` (acceso a la configuración de la app) solo si su
#  email está en esta lista Y está verificado. Se recalcula en cada inicio de
#  sesión: si quitas un email, esa cuenta pierde el rol al volver a entrar.
#  Se usa en: src/lib/auth/superadmin.ts.
#  Formato: dev@ejemplo.com,otra-dev@ejemplo.com
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAILS=""


# =============================================================================
#  Emails (verificación, recuperar contraseña…)
# =============================================================================

# -----------------------------------------------------------------------------
#  RESEND_API_KEY · servidor · OPCIONAL
# -----------------------------------------------------------------------------
#  Clave de Resend (https://resend.com) para enviar emails de verdad.
#  Sin ella, los emails NO se envían: se muestran en la consola y en la
#  bandeja de desarrollo http://localhost:3000/es/dev/outbox.
#  Formato: re_xxxxxxxx · Dónde: Resend → API Keys.
#  Se usa en: src/lib/email/send.ts.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""


# -----------------------------------------------------------------------------
#  EMAIL_FROM · servidor · OBLIGATORIA si hay RESEND_API_KEY
# -----------------------------------------------------------------------------
#  Remitente de los emails. El dominio debe estar verificado en Resend
#  (Resend → Domains).
#  Formato: "Nombre <no-reply@tu-dominio.com>"
# -----------------------------------------------------------------------------
EMAIL_FROM=""


# -----------------------------------------------------------------------------
#  EMAIL_DEV_OUTBOX · servidor · OPCIONAL · solo CI
# -----------------------------------------------------------------------------
#  Con 1, activa la bandeja de desarrollo también en un build de producción.
#  Solo la usa el CI, para que los e2e lean los enlaces de los emails.
#  ⚠️ Nunca en un despliegue real: expondría los enlaces de verificación.
#  En desarrollo (`pnpm dev`) la bandeja ya está activa sin esta variable.
# -----------------------------------------------------------------------------
# EMAIL_DEV_OUTBOX=1


# -----------------------------------------------------------------------------
#  NEXT_PUBLIC_APP_URL · pública · OBLIGATORIA
# -----------------------------------------------------------------------------
#  URL pública del sitio, sin "/" final.
#  Se usa para todas las URLs absolutas del SEO: canonical, hreflang,
#  sitemap.xml, robots.txt y Open Graph (src/lib/seo.ts).
#  Local:      http://localhost:3000
#  Producción: https://tu-dominio.com  (si queda mal, Google indexará URLs erróneas)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
#  NEXT_PUBLIC_GA_MEASUREMENT_ID · pública · OPCIONAL
# -----------------------------------------------------------------------------
#  ID de medición de Google Analytics 4.
#  - Si tiene valor, se carga Google Analytics en todas las páginas
#    (src/components/analytics.tsx, incluido en el layout).
#  - Si está vacía o no existe, no se carga nada.
#  Formato: G-XXXXXXXXXX
#  Dónde se obtiene: Google Analytics → Administrar → Flujos de datos → Web.
#  Recomendación: déjala vacía en local para no mezclar tus visitas de
#  desarrollo con las reales; defínela solo en producción.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""


# =============================================================================
#  Telemetría de herramientas (no las lee la app, sino Next.js y Prisma)
# =============================================================================

# -----------------------------------------------------------------------------
#  NEXT_TELEMETRY_DISABLED · OPCIONAL · recomendado: 1
# -----------------------------------------------------------------------------
#  Desactiva la telemetría anónima de Next.js (uso de funciones, tiempos de
#  build…).
#  En `.env` cubre `next build` y el servidor de desarrollo, pero el proceso
#  principal de `next dev` envía un evento al cerrarse antes de leer `.env`.
#  Para desactivarla del todo en tu equipo, ejecuta una vez:
#      pnpm exec next telemetry disable
#  En CI ya está desactivada (.github/workflows/ci.yml).
# -----------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1


# -----------------------------------------------------------------------------
#  CHECKPOINT_DISABLE · OPCIONAL · recomendado: 1
# -----------------------------------------------------------------------------
#  Desactiva el servicio "checkpoint" del CLI de Prisma: telemetría anónima y
#  comprobación de nuevas versiones.
# -----------------------------------------------------------------------------
CHECKPOINT_DISABLE=1


# =============================================================================
#  Variables que define la plataforma (no las pongas en `.env`)
# =============================================================================
#  VERCEL=1  → la define Vercel en sus builds y servidores. Activa Speed
#              Insights y Web Analytics de Vercel (src/components/vercel-insights.tsx).
#              Actívalos también en el panel del proyecto en Vercel:
#              Speed Insights → Enable · Analytics → Enable.
#  NODE_ENV  → la define Next.js ("development", "production") y Vitest ("test").


# -----------------------------------------------------------------------------
#  SKIP_ENV_VALIDATION · OPCIONAL · no la uses en producción
# -----------------------------------------------------------------------------
#  Con cualquier valor (ej. 1), desactiva la validación de `src/env.ts`.
#  Útil en builds de Docker o CI donde las variables reales no están
#  disponibles (por ejemplo, para ejecutar solo el lint).
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION=1
