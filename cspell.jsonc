// Shared by the cspell CLI (pnpm lint:spell, pre-commit) and the Code Spell Checker editor extension
{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  // Code and docs mix English and Spanish
  "language": "en,es",
  "import": ["@cspell/dict-es-es/cspell-ext.json"],
  "useGitignore": true,
  "ignorePaths": [
    ".git/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    // Generated
    "CHANGELOG.md",
    "prisma/migrations/**",
    "src/generated/**",
    "src/components/ui/**"
  ],
  // Project vocabulary (tools, libraries, identifiers). Keep sorted.
  "words": [
    "aaguid",
    "actionlint",
    "actívalos",
    "autenticador",
    "Authy",
    "autocompletado",
    "autoincrement",
    "bradlc",
    "commitlint",
    "configúrala",
    "configurarlo",
    "confírmalos",
    "ctap",
    "datasource",
    "davidanson",
    "Declárala",
    "declárala",
    "defínela",
    "desactívalo",
    "esnext",
    "extráelo",
    "Filenaming",
    "firefox",
    "formateador",
    "formateadores",
    "geist",
    "github",
    "googletagmanager",
    "googleusercontent",
    "hreflang",
    "indexables",
    "instálalas",
    "isready",
    "KHTML",
    "knip",
    "memoiza",
    "menuitemradio",
    "muévelo",
    "mydb",
    "networkidle",
    "nvmrc",
    "Opengraph",
    "opengraph",
    "paginación",
    "passwordless",
    "postgres",
    "postgresql",
    "precompilados",
    "prefault",
    "prerendered",
    "prerenderiza",
    "prerenders",
    "recalcula",
    "Redirección",
    "redirección",
    "redireccionamiento",
    "Refactorización",
    "reimplementar",
    "Renderiza",
    "renderiza",
    "renderizado",
    "renderizan",
    "renderizar",
    "reutilízalo",
    "shadcn",
    "superadmin",
    "superadmins",
    "tailwindcss",
    "Telemetría",
    "telemetría",
    "testear",
    "testid",
    "tipadas",
    "Tipado",
    "tipado",
    "tipados",
    "TOTP",
    "totp",
    "Turbopack",
    "unban",
    "unstub",
    "uuid",
    "Vercel",
    "vercel",
    "viewports",
    "Vitest",
    "webauthn"
  ]
}
