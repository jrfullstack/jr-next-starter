{
  "name": "16-jr-next-starter",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "email:dev": "email dev --dir src/emails --port 3030",
    "lint": "biome check && pnpm lint:tw && pnpm lint:md && pnpm lint:spell",
    "format": "biome format --write",
    "lint:fix": "biome check --write && node scripts/oxlint-fix.mjs && markdownlint-cli2 --fix",
    "lint:tw": "oxlint",
    "lint:md": "markdownlint-cli2",
    "lint:spell": "cspell --no-progress --dot \"**\"",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "dup": "jscpd",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm dup && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/third-parties": "^16.3.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.0",
    "resend": "^6.30.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-es-es": "^3.0.8",
    "@playwright/test": "^1.63.0",
    "@react-email/ui": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "^10.3.5",
    "dotenv": "^18.0.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.3",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.86.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "node scripts/oxlint-fix.mjs",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "vitest related --run"
    ],
    "*": [
      "cspell --no-progress --no-summary --no-must-find-files"
    ]
  }
}
